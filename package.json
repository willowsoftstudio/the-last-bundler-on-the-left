{
  "name": "shopify-cart-transform-bundle-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Native Shopify Cart Transform Bundle & Volume Discount App",
  "main": "web/backend/index.ts",
  "scripts": {
    "start": "tsx web/backend/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "build": "shopify app build",
    "dev": "shopify app dev",
    "deploy": "shopify app deploy",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:setup": "docker-compose up -d && sleep 3 && npx prisma db push && npx prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@shopify/shopify_function": "~2.0.0",
    "@shopify/shopify-api": "^11.14.1",
    "@shopify/shopify-app-express": "^5.0.20",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.0",
    "express": "^4.19.2",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@shopify/cli": "^4.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.15.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "wasm-opt": "^1.3.0"
  }
}
