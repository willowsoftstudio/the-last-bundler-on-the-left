datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?
  locale              String?
  collaborator        Boolean?
  emailVerified       Boolean?
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Bundle {
  id              String           @id @default(uuid())
  title           String
  parentVariantId String
  components      Json             // Array of { variantId: string, quantity: number }
  salesChannels   Json?            // Array of string identifiers or publication objects
  createdAt       DateTime         @default(now())
  analytics       BundleAnalytics?
  orders          BundleOrder[]
}

model BundleAnalytics {
  bundleId       String   @id
  totalRevenue   Float    @default(0.0)
  totalUnitsSold Int      @default(0)
  totalOrders    Int      @default(0)
  totalDiscounts Float    @default(0.0)
  updatedAt      DateTime @updatedAt

  bundle         Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
}

model BundleOrder {
  id             String   @id @default(uuid())
  bundleId       String
  orderId        String   // Shopify Order ID
  customerName   String?
  customerEmail  String?
  quantity       Int
  revenue        Float
  discountAmount Float
  purchasedAt    DateTime @default(now())

  bundle         Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  
  @@index([bundleId])
  @@index([orderId])
}

model Analytics {
  id                     String   @id @default("global_analytics")
  totalRevenue           Float    @default(0.0)
  totalOrdersWithBundles Int      @default(0)
  totalBundlesSold       Int      @default(0)
  updatedAt              DateTime @updatedAt
}

model SeederMigration {
  id        String   @id
  appliedAt DateTime @default(now())
}
